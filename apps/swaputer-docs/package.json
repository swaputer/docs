{
  "name": "@swaputer/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1 --port 4177",
    "check:drift": "node scripts/check-docs.mjs",
    "build": "npm run check:drift && vitepress build docs",
    "preview": "vitepress preview docs --host 127.0.0.1 --port 4177",
    "deploy:pages": "npm run build && wrangler pages deploy docs/.vitepress/dist --project-name swaputer-docs --branch main"
  },
  "dependencies": {
    "vue": "3.5.42"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.20",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
